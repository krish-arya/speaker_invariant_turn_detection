# Copy to backend/.env (never commit .env). Secrets stay on the server/worker only.

# --- LiveKit transport (needed for live microphone sessions) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Hosted provider profile (default) ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# TURNSENSE_STT_MODEL=nova-3
# TURNSENSE_LLM_MODEL=llama-3.1-8b-instant
# TURNSENSE_TTS_VOICE=aura-2-thalia-en

# --- Local/open fallback profile (pip install -e ".[local]" and run Ollama) ---
# TURNSENSE_RUNTIME_PROFILE=local
# TURNSENSE_OLLAMA_URL=http://localhost:11434
# TURNSENSE_OLLAMA_MODEL=llama3.2:3b
# TURNSENSE_WHISPER_MODEL=small.en

# --- Evaluation set replay (labelled recordings through the live pipeline) ---
# TURNSENSE_REPLAY_MANIFEST=runs/synthetic-quick-v1/data/manifest.jsonl
# TURNSENSE_REPLAY_SPLIT=runs/synthetic-quick-v1/split.json   # replay only test_unseen speakers

# --- Server ---
# TURNSENSE_DATA_DIR=./data
# TURNSENSE_CHECKPOINT_DIR=./checkpoints
# TURNSENSE_MIN_PERCENTILE_SAMPLES=20
# TURNSENSE_TOKEN_TTL_S=600
# TURNSENSE_LIVE_VAD=silero
